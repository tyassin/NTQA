{
  "task_name": "Create Okta Group",
  "description": "Create a new OKTA Group!",
  "command": [
    "curl -sS -X POST \\",
    "  -H \"Accept: application/json\" \\",
    "  -H \"Content-Type: application/json\" \\",
    "  -H \"Authorization: SSWS $OKTA_API_TOKEN\" \\",
    "  -d '{\"profile\": {\"name\": \"${answer1}\", \"description\": \"${answer2}\"}}' \\",
    "  \"$OKTA_URL/api/v1/groups\""
  ],
  "questions": [
    "What is the new okta group name?*",
    "What is the new okta group description?*"
  ]
}