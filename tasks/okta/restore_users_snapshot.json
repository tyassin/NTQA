{
  "task_name": "Restore Users Snapshot",
  "description": "Smart-restore Okta users from a snapshot file by recreating deleted users and updating modified user profiles.",
  "command": [
    "python3 -c '",
    "import os, sys, json, subprocess",
    "snap = \"${answer1}\".strip()",
    "snap = snap if os.path.exists(snap) else (f\"snapshots/users_snapshot_{snap}.json\" if os.path.exists(f\"snapshots/users_snapshot_{snap}.json\") else snap)",
    "if not os.path.exists(snap):",
    "    print(json.dumps({\"error\": f\"Snapshot {snap} not found\", \"status\": \"failed\"})); sys.exit(0)",
    "snap_users = json.load(open(snap))",
    "okta_url = os.getenv(\"OKTA_URL\", \"\").rstrip(\"/\")",
    "token = os.getenv(\"OKTA_API_TOKEN\", \"\")",
    "def okta_get(path):",
    "    r = subprocess.run([\"curl\",\"-sS\",\"-X\",\"GET\",",
    "        \"-H\",\"Accept: application/json\",",
    "        \"-H\",\"Content-Type: application/json\",",
    "        \"-H\",f\"Authorization: SSWS {token}\",",
    "        f\"{okta_url}{path}\"], capture_output=True, text=True)",
    "    return json.loads(r.stdout) if r.stdout.strip() else []",
    "def okta_post(path, payload, method=\"POST\"):",
    "    r = subprocess.run([\"curl\",\"-sS\",\"-X\",method,",
    "        \"-H\",\"Accept: application/json\",",
    "        \"-H\",\"Content-Type: application/json\",",
    "        \"-H\",f\"Authorization: SSWS {token}\",",
    "        \"-d\",json.dumps(payload),",
    "        f\"{okta_url}{path}\"], capture_output=True, text=True)",
    "    return r.returncode, r.stdout",
    "cur_users = okta_get(\"/api/v1/users?limit=200\") if token else []",
    "cur_by_login = {u.get(\"profile\",{}).get(\"login\",\"\").lower(): u for u in cur_users}",
    "created, updated, skipped, errors = [], [], [], []",
    "for u in snap_users:",
    "    sp = u.get(\"profile\", {}); login = sp.get(\"login\", sp.get(\"email\",\"\")).lower()",
    "    if not login: continue",
    "    if login not in cur_by_login:",
    "        rc, out = okta_post(\"/api/v1/users?activate=true\", {\"profile\": sp, \"credentials\": {\"password\": {\"value\": \"TempRestore123!\"}}})",
    "        (created if rc == 0 else errors).append(login)",
    "    else:",
    "        cur_p = cur_by_login[login].get(\"profile\", {}); cur_id = cur_by_login[login].get(\"id\")",
    "        diff = {k: v for k, v in sp.items() if v is not None and cur_p.get(k) != v}",
    "        if diff:",
    "            rc, out = okta_post(f\"/api/v1/users/{cur_id}\", {\"profile\": diff})",
    "            (updated if rc == 0 else errors).append(login)",
    "        else: skipped.append(login)",
    "print(json.dumps({\"status\": \"completed\", \"snapshot\": snap, \"recreated_deleted\": len(created), \"updated_modified\": len(updated), \"untouched_skipped\": len(skipped), \"errors\": errors}))",
    "'"
  ],
  "auto_summarize": true,
  "questions": [
    "What is the snapshot file path or tag name to restore from? (e.g. 'before', 'snapshots/users_snapshot_before.json')*"
  ]
}
